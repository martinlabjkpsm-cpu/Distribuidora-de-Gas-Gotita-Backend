# Copiar como .env.local en la EC2 y completar. .env.local NO se sube a Git.
DB_URL=jdbc:postgresql://<endpoint-rds>:5432/gotita_db?sslmode=require
DB_USER=postgres
DB_PASSWORD=
# Generar con: openssl rand -base64 48
JWT_SECRET=
# Vigencia del token en minutos (opcional, 30 por defecto; 1 para probar la expiración)
JWT_MINUTOS=30
CORS_ORIGINS=http://localhost:5173
# Opcional: crea 4 usuarios de prueba (uno por rol) con esta contraseña
DEMO_PASSWORD=
